{
  "name": "hackingbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, tool-restricted LLM speedrun workbench for Hacknet",
  "packageManager": "bun@1.4.4",
  "engines": { "bun": ">=1.4.4" },
  "scripts": {
    "start": "bun --no-install src/cli.tsx",
    "demo": "bun --no-install src/cli.tsx --demo",
    "doctor": "bun --no-install src/cli.tsx doctor",
    "setup": "bun --no-install src/cli.tsx setup",
    "typecheck": "bun --no-install node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test ./test",
    "check": "bun run typecheck && bun run test",
    "smoke:pi": "bun --no-install scripts/smoke-pi.ts",
    "smoke:game": "bun --no-install scripts/smoke-game.ts"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "ink": "6.8.0",
    "ink-text-input": "6.0.0",
    "react": "19.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9.3"
  }
}
